# ============================================================
# FONTE MANUSCRITA OPCIONAL
# ============================================================

FONTE_MANUSCRITA = None


def procurar_fonte():
    global FONTE_MANUSCRITA

    garantir_pasta()

    nomes = [
        "manuscrita.ttf",
        "manuscrito.ttf",
        "carta.ttf",
        "handwriting.ttf",
        "script.ttf",
        "estilo.ttf"
    ]

    for nome in nomes:
        caminho = os.path.join(PASTA, nome)

        if not os.path.exists(caminho):
            continue

        try:
            LabelBase.register(
                name="CartaManuscrita",
                fn_regular=caminho
            )

            FONTE_MANUSCRITA = "CartaManuscrita"

            print("Fonte carregada:", caminho)

            return FONTE_MANUSCRITA

        except Exception as erro:
            print("Erro ao carregar fonte:", erro)

    FONTE_MANUSCRITA = None
    return None


# ============================================================
# PASTA
# ============================================================

def garantir_pasta():
    try:
        os.makedirs(
            PASTA,
            exist_ok=True
        )
    except Exception as erro:
        print("Erro ao criar pasta:", erro)


# ============================================================
# CONFIGURAÇÃO
# ============================================================

def carregar_config():
    garantir_pasta()

    if not os.path.exists(ARQUIVO_CONFIG):
        config = {
            "finalizado": False,
            "fonte": 24,
            "principal": ""
        }

        salvar_config(config)
        return config

    try:
        with open(
            ARQUIVO_CONFIG,
            "r",
            encoding="utf-8"
        ) as arquivo:

            config = json.load(arquivo)

        if not isinstance(config, dict):
            raise ValueError("Configuração inválida")

        return config

    except Exception as erro:
        print("Erro ao carregar configuração:", erro)

        return {
            "finalizado": False,
            "fonte": 24,
            "principal": ""
        }


def salvar_config(config):
    garantir_pasta()

    try:
        with open(
            ARQUIVO_CONFIG,
            "w",
            encoding="utf-8"
        ) as arquivo:

            json.dump(
                config,
                arquivo,
                indent=4,
                ensure_ascii=False
            )

    except Exception as erro:
        print("Erro ao salvar configuração:", erro)


# ============================================================
# MÍDIA
# ============================================================

def listar_arquivos():
    garantir_pasta()

    arquivos = []

    try:
        for nome in os.listdir(PASTA):

            caminho = os.path.join(
                PASTA,
                nome
            )

            if not os.path.isfile(caminho):
                continue

            extensao = os.path.splitext(
                nome
            )[1].lower()

            if (
                extensao in EXTENSOES_FOTO
                or
                extensao in EXTENSOES_VIDEO
            ):
                arquivos.append(caminho)

    except Exception as erro:
        print("Erro ao listar arquivos:", erro)

    return sorted(arquivos)


def listar_fotos():
    return [
        arquivo
        for arquivo in listar_arquivos()
        if os.path.splitext(arquivo)[1].lower()
        in EXTENSOES_FOTO
    ]


def encontrar_principal():
    config = carregar_config()

    principal = config.get(
        "principal",
        ""
    )

    if principal and os.path.exists(principal):
        return principal

    nomes = [
        "principal.jpg",
        "principal.jpeg",
        "principal.png",
        "principal.webp"
    ]

    for nome in nomes:

        caminho = os.path.join(
            PASTA,
            nome
        )

        if os.path.exists(caminho):
            return caminho

    fotos = listar_fotos()

    if fotos:
        return fotos[0]

    return None


