def abrir_video(caminho):

    try:
        subprocess.Popen(
            [
                "am",
                "start",
                "-a",
                "android.intent.action.VIEW",
                "-d",
                "file://" + caminho,
                "-t",
                "video/*"
            ]
        )

    except Exception as erro:
        print("Erro ao abrir vídeo:", erro)


