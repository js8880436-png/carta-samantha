        )

        layout.add_widget(tamanho_label)

        fontes = BoxLayout(
            orientation="horizontal",
            spacing=8,
            size_hint_y=None,
            height=62
        )

        for tamanho in (18, 22, 26, 31):

            botao = BotaoCarta(
                text="A",
                font_size=tamanho,
                color=BRANCO
            )

            botao.bind(
                on_release=lambda btn,
                t=tamanho:
                self.escolher_fonte(t)
            )

            fontes.add_widget(botao)

        layout.add_widget(fontes)

        galeria = BotaoCarta(
            text="📜  VER FOTOS E VÍDEOS",
            font_size=19,
            bold=True,
            color=BRANCO,
            size_hint_y=None,
            height=75
        )

        galeria.bind(
            on_release=self.abrir_galeria
        )

        layout.add_widget(galeria)

        finalizar = BotaoCarta(
            text="♥  SELAR A CARTA",
            font_size=21,
            bold=True,
            color=BRANCO,
            selo=True,
            size_hint_y=None,
            height=82
        )

        finalizar.bind(
            on_release=self.finalizar
        )

        layout.add_widget(finalizar)

        self.status = Label(
            text="",
            font_size=15,
            color=VINHO,
            halign="center",
            size_hint_y=None,
            height=31
        )

        layout.add_widget(self.status)

        self.add_widget(layout)

    def on_enter(self):

        procurar_fonte()

        config = carregar_config()

        if os.path.exists(ARQUIVO_MENSAGEM):

            try:
                with open(
                    ARQUIVO_MENSAGEM,
                    "r",
                    encoding="utf-8"
                ) as arquivo:

                    self.mensagem.text = arquivo.read()

            except Exception as erro:
                print(
                    "Erro ao carregar mensagem:",
                    erro
                )

        self.mensagem.font_size = config.get(
            "fonte",
            24
        )

        if FONTE_MANUSCRITA:

            try:
                self.mensagem.font_name = (
                    FONTE_MANUSCRITA
                )
            except Exception:
                pass

    def escolher_fonte(self, tamanho):

        self.mensagem.font_size = tamanho

        config = carregar_config()
        config["fonte"] = tamanho

        salvar_config(config)

    def abrir_galeria(self, instance):

        self.manager.current = (
            "criador_galeria"
        )

    def finalizar(self, instance):

        texto = self.mensagem.text.strip()

        if not texto:

            self.status.text = (
                "Escreva a carta antes de selá-la."
            )

            return

        try:

            garantir_pasta()

            with open(
                ARQUIVO_MENSAGEM,
                "w",
                encoding="utf-8"
            ) as arquivo:

                arquivo.write(texto)

            config = carregar_config()

            config["finalizado"] = True

            principal = encontrar_principal()

            if principal:
                config["principal"] = principal

            salvar_config(config)

            self.manager.current = "finalizado"

        except Exception as erro:

            self.status.text = (
                "Não foi possível salvar."
            )

            print(
                "Erro ao finalizar:",
                erro
            )


