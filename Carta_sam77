                    font_size=25,
                    color=BRANCO,
                    size_hint_y=None,
                    height=190
                )

                video.bind(
                    on_release=lambda btn,
                    arquivo=caminho:
                    abrir_video(arquivo)
                )

                self.grade.add_widget(video)

    def voltar(self, instance):

        self.manager.current = "carta"


